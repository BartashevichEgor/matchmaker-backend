# Copy to .env and set a random JWT_SECRET of at least 32 characters.
# Windows start.ps1 creates a secret automatically when .env does not exist.
ENVIRONMENT=local
JWT_SECRET=
# SQLite is the local fallback when DATABASE_URL is omitted.
# DATABASE_URL=postgresql+psycopg://matchmaker:YOUR_PASSWORD@127.0.0.1:5432/matchmaker
# REDIS_URL=redis://127.0.0.1:6379/0
MAIL_MODE=outbox
MAIL_SERVER=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=noreply@matchmaker.local
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
