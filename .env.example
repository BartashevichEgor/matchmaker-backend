# Docker Compose settings, separate from core-api/.env.
ENVIRONMENT=local
POSTGRES_DB=matchmaker
POSTGRES_USER=matchmaker
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
WEB_BASE_URL=http://localhost:5173
MAIL_MODE=smtp
MAIL_SERVER=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@example.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_CREDENTIALS=false
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
REFRESH_COOKIE_SECURE=false
CHAT_POSTGRES_PASSWORD=replace-with-a-different-long-random-password
CHAT_PORT=3000
CHAT_ALLOWED_ORIGINS=http://localhost:5173
